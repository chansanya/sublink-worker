{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sublink-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  "kv_namespaces": [
    // 不写 id：wrangler 部署时会在账号里自动创建 SUBLINK_KV 并回填（需 wrangler >= 4.45）。
    // 本地 wrangler dev 用本地模拟 KV。
    { "binding": "SUBLINK_KV" }
  ]
}
